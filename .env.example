# Copy this file to .env for local development. Never commit the real .env.
# On Render, set these same names as real Environment Variables instead —
# don't upload this file there either.

DATAVERSE_ENV_URL=https://yourorg.api.crm8.dynamics.com
DATAVERSE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DATAVERSE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DATAVERSE_CLIENT_SECRET=your-client-secret-here

# Comma-separated list of origins allowed to call this API from a browser.
# Leave unset ("*") only while testing locally.
ALLOWED_ORIGINS=http://localhost:5183,https://your-power-pages-site.powerappsportals.com

# --- Everything below is optional — each has a built-in default, so the
# backend runs fine without any of these set. Set one only when you want to
# change that behavior without editing dataverse.py. ---

# Schema-name prefix for a table/column when the caller doesn't specify one
# (e.g. "new_MyTable"). Default if unset: new
DEFAULT_TABLE_PREFIX=new

# Unmanaged solution new tables/columns are added to. Default if unset:
# the environment's Default solution (i.e. no solution header sent at all).
SOLUTION_UNIQUE_NAME=

# 'UserOwned' or 'OrganizationOwned' for a newly created table.
# Default if unset: UserOwned
DEFAULT_OWNERSHIP_TYPE=UserOwned

# The mspp_website record id that Web API site settings/table permissions
# attach to (ensure_webapi_access). Default if unset: this project's own
# confirmed live site id (org5abb8a7b) — override if pointed at a different
# Power Pages site.
POWER_PAGES_WEBSITE_ID=

# The mspp_webrole id bound to every table permission ensure_webapi_access
# creates. Default if unset: this project's own confirmed live
# "Administrators" role id — override to grant a different role instead.
ADMINISTRATORS_WEBROLE_ID=
